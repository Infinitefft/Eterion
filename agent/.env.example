# Node Agent 服务监听地址
AGENT_HOST=127.0.0.1
AGENT_PORT=8001

# 前端未显式传 model_id 时使用的模型实例 ID
DEFAULT_MODEL_ID=deepseek-v4-pro

# 只有配置了对应 *_MODEL 的模型才会被启用；不使用的模型请注释整段配置。

# 火山方舟（豆包）OpenAI 兼容接口
DOUBAO_API_KEY=replace-with-your-doubao-api-key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_SEED_2_1_PRO_MODEL=doubao-seed-2-1-pro-260628
DOUBAO_SEED_2_1_PRO_NAME=Doubao-Seed-2.1-pro
DOUBAO_ICON_URL=/model-icons/doubao-seed-2-1-pro.png

# DeepSeek OpenAI 兼容接口
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_V4_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_V4_PRO_NAME=DeepSeek-V4-Pro
DEEPSEEK_ICON_URL=/model-icons/deepseek-v4-pro.png

# MiniMax 国内 OpenAI 兼容接口
MINIMAX_API_KEY=replace-with-your-minimax-api-key
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_M2_7_MODEL=MiniMax-M2.7
MINIMAX_M2_7_NAME=MiniMax M2.7
MINIMAX_ICON_URL=/model-icons/minimax-m2-7.png

MODEL_TIMEOUT=2m
# 项目采用的保守窗口预算，并非厂商最大值；应不超过所用模型支持的上下文窗口。
MODEL_CONTEXT_WINDOW=32768
# 总输入达到此值时，在下次模型调用前尝试压缩；包含系统提示词和工具定义。
MODEL_AUTO_COMPACT_TOKEN_LIMIT=20000
# 模型专属值优先于通用值。DeepSeek 使用 258k 应用预算，180k 时触发压缩。
DEEPSEEK_V4_PRO_CONTEXT_WINDOW=258000
DEEPSEEK_V4_PRO_AUTO_COMPACT_TOKEN_LIMIT=180000
# 其他模型沿用通用预算；确认容量后可分别设置：
# DOUBAO_SEED_2_1_PRO_CONTEXT_WINDOW=32768
# DOUBAO_SEED_2_1_PRO_AUTO_COMPACT_TOKEN_LIMIT=20000
# MINIMAX_M2_7_CONTEXT_WINDOW=32768
# MINIMAX_M2_7_AUTO_COMPACT_TOKEN_LIMIT=20000
# 主模型和摘要模型的输出上限均为 4096 tokens。
# 将 prompts/system.example.md 复制为 prompts/system.local.md 后编辑，私人文件不提交 Git。
# 相对路径基于 agent/；部署时也可设置为挂载文件的绝对路径。
SYSTEM_PROMPT_FILE=prompts/system.local.md
AGENT_RUN_TIMEOUT=10m
AGENT_HEARTBEAT=15s
# Agent 从 Go 内部接口获取原始聊天历史，再自行组装模型上下文。
GO_API_BASE_URL=http://127.0.0.1:8080

# 可选的本地运行记录（启用时使用 Node.js 22.19.0+），默认不写入任何记录。
AGENT_RECORDING_ENABLED=false
# 相对 agent/ 解析；平台无需启动，记录器自行创建此目录及 records.sqlite。
AGENT_RECORDING_DIR=../.run-records

# 博查网页搜索 Tool。真实 Key 只填在 .env，不要填进这个示例文件。
BOCHA_API_KEY=replace-with-your-bocha-api-key

# 如果不使用上面的内置目录，也可以只配置一个通用 OpenAI-compatible 模型：
# MODEL_API_KEY=replace-with-your-api-key
# MODEL_BASE_URL=https://example.com/v1
# MODEL_NAME=provider-model-name
