{
  "name": "@eterion/agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "patchedDependencies": {
      "langchain@1.5.10": "patches/langchain@1.5.10.patch"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "eval:agent": "tsx evals/smoke-agent.ts",
    "start": "node dist/index.js",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:record-store": "tsx scripts/check-record-store.ts",
    "check:ingestion-recording": "pnpm build && node scripts/check-ingestion-recording.mjs",
    "check:model-recording": "pnpm build && node scripts/check-model-recording.mjs",
    "check:tool-recording": "pnpm build && node scripts/check-tool-recording.mjs",
    "check:rag-search-recording": "pnpm build && node scripts/check-rag-search-recording.mjs"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.20.0"
  },
  "dependencies": {
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.13",
    "@langchain/openai": "1.5.10",
    "@langchain/textsplitters": "1.0.1",
    "cheerio": "1.2.0",
    "dotenv": "17.4.2",
    "fastify": "5.12.1",
    "js-tiktoken": "1.0.21",
    "langchain": "1.5.10",
    "pg": "8.23.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "26.1.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
