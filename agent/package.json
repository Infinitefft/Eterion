{
  "name": "@eterion/agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "eval:agent": "tsx evals/smoke-agent.ts",
    "start": "node dist/index.js",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.20.0"
  },
  "dependencies": {
    "@langchain/core": "1.2.9",
    "@langchain/openai": "1.5.10",
    "cheerio": "1.2.0",
    "dotenv": "17.4.2",
    "fastify": "5.12.1",
    "langchain": "1.5.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
