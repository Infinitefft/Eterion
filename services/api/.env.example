# 负责展示 Go API 本地运行所需的环境变量示例，复制为 .env 后再填写真实值。
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:replace-me@localhost:5432/eterion?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=eterion-api
JWT_AUDIENCE=eterion-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

REFRESH_COOKIE_NAME=eterion_rt
REFRESH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 前端未显式传 model_id 时使用的模型实例 ID
DEFAULT_MODEL_ID=deepseek-v4-pro

# 模型实例变量：*_MODEL 用于厂商请求，*_NAME 仅作为返回前端的 modelName。
# 同一厂商新增模型时使用新的模型后缀，凭证、Base URL 和 Icon 继续复用厂商变量。

# 火山方舟（豆包）OpenAI 兼容接口
DOUBAO_API_KEY=replace-with-your-doubao-api-key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_SEED_2_1_PRO_MODEL=doubao-seed-2-1-pro-260628
DOUBAO_SEED_2_1_PRO_NAME=Doubao-Seed-2.1-pro
DOUBAO_ICON_URL=/model-icons/doubao-seed-2-1-pro.png

# DeepSeek OpenAI 兼容接口
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_V4_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_V4_PRO_NAME=DeepSeek-V4-Pro
DEEPSEEK_ICON_URL=/model-icons/deepseek-v4-pro.png

# MiniMax 国内 OpenAI 兼容接口；国际账号请改为 https://api.minimax.io/v1
MINIMAX_API_KEY=replace-with-your-minimax-api-key
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_M2_7_MODEL=MiniMax-M2.7
MINIMAX_M2_7_NAME=MiniMax M2.7
MINIMAX_ICON_URL=/model-icons/minimax-m2-7.png

MODEL_TIMEOUT=2m
SYSTEM_PROMPT=你是 Eterion 的 AI 助手。请准确、清晰地回答用户问题。

# 可选：填写后会把 web_search Tool 注册给所有聊天模型。
# 在 https://api.search.brave.com/app/keys 创建并复制 API Key。
BRAVE_SEARCH_API_KEY=
AGENT_RUN_TIMEOUT=10m
WS_TICKET_TTL=45s
