# 负责展示 Go API 本地运行所需的环境变量示例，复制为 .env 后再填写真实值。
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:replace-me@localhost:5432/eterion?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=eterion-api
JWT_AUDIENCE=eterion-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

REFRESH_COOKIE_NAME=eterion_rt
REFRESH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173

AGENT_GRPC_ADDR=127.0.0.1:50051
AGENT_SHARED_SECRET=replace-with-the-same-agent-secret
AGENT_RUN_TIMEOUT=10m
WS_TICKET_TTL=45s
