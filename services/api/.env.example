# 负责展示 Go API 本地运行所需的环境变量示例，复制为 .env 后再填写真实值。
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:replace-me@localhost:5432/eterion?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=eterion-api
JWT_AUDIENCE=eterion-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

REFRESH_COOKIE_NAME=eterion_rt
REFRESH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 前端未显式传 model_id 时使用的模型：doubao / deepseek / minimax
DEFAULT_MODEL_ID=deepseek

# 火山方舟（豆包）OpenAI 兼容接口
DOUBAO_API_KEY=replace-with-your-doubao-api-key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=replace-with-your-doubao-model-or-endpoint-id

# DeepSeek OpenAI 兼容接口
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=replace-with-your-deepseek-model

# MiniMax 国内 OpenAI 兼容接口；国际账号请改为 https://api.minimax.io/v1
MINIMAX_API_KEY=replace-with-your-minimax-api-key
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=replace-with-your-minimax-model

MODEL_TIMEOUT=2m
SYSTEM_PROMPT=你是 Eterion 的 AI 助手。请准确、清晰地回答用户问题。
AGENT_RUN_TIMEOUT=10m
WS_TICKET_TTL=45s
